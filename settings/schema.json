{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "weekly_schedule",
  "description": "各曜日（monday 〜 sunday）の時間設定",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "holiday": { "$ref": "#/definitions/daily_schedule" },
    "monday": { "$ref": "#/definitions/daily_schedule" },
    "tuesday": { "$ref": "#/definitions/daily_schedule" },
    "wednesday": { "$ref": "#/definitions/daily_schedule" },
    "thursday": { "$ref": "#/definitions/daily_schedule" },
    "friday": { "$ref": "#/definitions/daily_schedule" },
    "saturday": { "$ref": "#/definitions/daily_schedule" },
    "sunday": { "$ref": "#/definitions/daily_schedule" }
  },
  "required": [
    "monday",
    "tuesday",
    "wednesday",
    "thursday",
    "friday",
    "saturday",
    "sunday"
  ],
  "definitions": {
    "audio_type": {
      "type": "string",
      "title": "audio_type",
      "description": "音声タイプ",
      "enum": ["DEFAULT", "NOTIFICATION", "ALARM"]
    },
    "daily_schedule": {
      "type": "array",
      "title": "hour_settings",
      "description": "時間毎の設定",
      "items": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "number",
            "title": "hour",
            "description": "時間 (0-23)"
          },
          "minutes": {
            "type": "array",
            "title": "minutes",
            "description": "分 (0-59)",
            "items": {
              "type": "number"
            },
            "minItems": 0,
            "maxItems": 60,
            "uniqueItems": true
          },
          "minute_settings": {
            "type": "object",
            "title": "minute_settings",
            "description": "分ごとの詳細設定",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "sound_file_name": {
                  "type": "string",
                  "title": "sound_file_name",
                  "description": "サウンドファイル名"
                },
                "sound_types": {
                  "type": "array",
                  "title": "sound_types",
                  "description": "再生対象の音声タイプ一覧",
                  "items": {
                    "$ref": "#/definitions/audio_type"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": ["sound_file_name"]
            }
          }
        },
        "required": ["hour"]
      },
      "minItems": 0,
      "maxItems": 24
    }
  }
}
